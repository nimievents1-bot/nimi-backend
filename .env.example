# =============================================================
# nimi-api — environment template
# Copy this file to `.env` (dev) and fill in real values.
# Never commit `.env`.
# =============================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://nimi:nimi@localhost:5432/nimi
SHADOW_DATABASE_URL=postgres://nimi:nimi@localhost:5432/nimi_shadow

# Redis (rate limit, throttle, queues)
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 32
JWT_SECRET=Sjg9Dd7nZUyRFBiF+pth12eOa8jdrlmic2k3Bp+CZ3k=
JWT_REFRESH_SECRET=ssz1fTYvM741iEywZzNNsn116IPRP8Sx2HMeHvubd/4=

# Access token TTL in seconds. Default is 24 hours (86400).
# The web proxy silently refreshes the access token using the refresh
# cookie, so this mostly controls how often that refresh dance runs
# during continuous use — NOT how long a user can stay signed in.
JWT_ACCESS_TTL=86400

# Refresh token TTL in seconds. Default is 10 years (315360000).
# Operator policy: sessions never expire on their own. A customer who
# doesn't sign out should not be logged out. Every refresh rotates
# this token forward, so as long as the user comes back inside this
# window they stay signed in indefinitely.
JWT_REFRESH_TTL=315360000

COOKIE_DOMAIN=localhost

# CORS — comma-separated list of allowed origins. Order does NOT matter.
# In production, include both the bare and www variants of your canonical
# domain, plus any preview URLs you actively use.
WEB_ORIGIN=http://localhost:3000

# THE canonical public URL of the web app. Used to build absolute links
# in transactional emails (verify, reset, receipts, etc.). MUST be a
# single URL with no trailing slash. In production set this to
# https://nimievents.com — NEVER a Vercel preview URL.
WEB_PUBLIC_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-09-30.acacia

# Email — Resend
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Object storage — Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nimi-uploads-dev
R2_PUBLIC_URL=

# Bot protection
TURNSTILE_SECRET_KEY=

# Observability
SENTRY_DSN=

# Inboxes
SUPPORT_INBOX=nimi.events1@gmail.com
NOREPLY_INBOX=noreply@nimievents.com
