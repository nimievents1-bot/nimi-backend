# =============================================================
# nimi-api — environment template
# Copy this file to `.env` (dev) and fill in real values.
# Never commit `.env`.
# =============================================================

NODE_ENV=development
PORT=3001
LOG_LEVEL=debug

# Database
DATABASE_URL=postgres://nimi:nimi@localhost:5432/nimi
SHADOW_DATABASE_URL=postgres://nimi:nimi@localhost:5432/nimi_shadow

# Redis (rate limit, throttle, queues)
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 32
JWT_SECRET=replace-me-32-bytes-of-base64
JWT_REFRESH_SECRET=replace-me-32-bytes-of-base64
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
COOKIE_DOMAIN=localhost

# CORS — comma-separated list of allowed origins
WEB_ORIGIN=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-09-30.acacia

# Email — Resend
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Object storage — Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=nimi-uploads-dev
R2_PUBLIC_URL=

# Bot protection
TURNSTILE_SECRET_KEY=

# Observability
SENTRY_DSN=

# Inboxes
SUPPORT_INBOX=hello@nimievents.co.uk
NOREPLY_INBOX=noreply@nimievents.co.uk
