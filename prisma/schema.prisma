// Prisma schema for Nimi Events API.
//
// Updated for Phase 1: adds EmailVerificationToken, PasswordResetToken,
// and ContactEnquiry to support the auth module and the public contact form.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// Identity & access
// =============================================================

enum Role {
  CUSTOMER
  EDITOR
  SUPPORT
  OWNER
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  passwordHash    String
  name            String
  phone           String?
  role            Role      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  totpSecret      String?
  deletedAt       DateTime?

  /// Day of month the customer's birthday falls on (1–31). Optional.
  /// Year is intentionally not collected — we only need DD/MM to fire the
  /// Klaviyo birthday flow each year, and avoiding the year means we don't
  /// hold age-related PII or hit GDPR special-category data thresholds.
  birthDay   Int?
  /// Month of birthday (1–12). Optional, paired with `birthDay`.
  birthMonth Int?

  // ------------------------------------------------------------------
  // Default delivery address.
  // ------------------------------------------------------------------
  // Stored at the user level rather than the order level so the operator
  // can ship recurring deliveries (Indulgence Club, gifting, etc.)
  // without having to wait for the customer to enter an address per
  // event. Also pre-fills the pastry checkout so a returning customer
  // doesn't retype their details. All fields are optional — a customer
  // can sign up, browse, and only fill these in when they actually need
  // a delivery.
  addressLine1 String?
  addressLine2 String?
  addressCity  String?
  addressPostcode String?
  /// ISO-3166 alpha-2 country code. Defaults to GB on save when blank
  /// because v1 only ships within the UK.
  addressCountry String?

  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens          RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  auditLogs              AuditLog[] @relation("AuditActor")
  subscription           Subscription?
  pastryCart             PastryCart?
  pastryOrders           PastryOrder[]
  notifications          Notification[]

  @@index([role])
  @@index([deletedAt])
}

model RefreshToken {
  id            String    @id @default(uuid())
  userId        String
  hash          String    @unique
  familyId      String
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  ip            String?
  userAgent     String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  hash      String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  hash      String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// =============================================================
// Audit log — append-only
// =============================================================

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?

  createdAt DateTime @default(now())

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

// =============================================================
// CMS — content blocks and editorial models
// =============================================================

model ContentBlock {
  id          String    @id @default(uuid())
  page        String
  key         String
  locale      String    @default("en")
  type        String
  payload     Json
  version     Int       @default(1)
  publishedAt DateTime?
  updatedBy   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([page, key, locale, version])
  @@index([page, key, locale, publishedAt])
}

model Faq {
  id        String  @id @default(uuid())
  category  String
  question  String
  answer    String
  position  Int     @default(0)
  published Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, position])
}

model GalleryImage {
  id       String  @id @default(uuid())
  page     String
  url      String
  alt      String
  caption  String?
  position Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([page, position])
}

enum BlogPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

model BlogPost {
  id          String         @id @default(uuid())
  slug        String         @unique
  title       String
  excerpt     String
  /// Sanitised HTML body. Validated server-side before persist.
  body        String
  /// Optional cover image URL.
  coverUrl    String?
  /// Optional cover alt text — required when coverUrl is set.
  coverAlt    String?
  /// Author display name (free text for now; later could link to a User).
  authorName  String
  /// Free-text category label, e.g. "Behind the kitchen", "Gifting", "Cravings".
  category    String?
  /// Tag list as JSON array of strings.
  tags        Json           @default("[]")
  status      BlogPostStatus @default(DRAFT)
  publishedAt DateTime?
  /// SEO meta — separate from `title`/`excerpt` so editors can override.
  seoTitle       String?
  seoDescription String?
  ogImageUrl     String?

  /// Word count snapshot for the index. Server-computed on every save.
  wordCount Int @default(0)

  /// Audit trail.
  createdBy String
  updatedBy String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([category, status, publishedAt])
}

// =============================================================
// Marketing
// =============================================================

enum NewsletterStatus {
  PENDING
  CONFIRMED
  UNSUBSCRIBED
}

model NewsletterSubscriber {
  id          String           @id @default(uuid())
  email       String           @unique
  status      NewsletterStatus @default(PENDING)
  consentAt   DateTime?
  source      String?
  externalId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// =============================================================
// Public contact / enquiry form
// =============================================================

enum ContactStatus {
  NEW
  CONTACTED
  CLOSED
  SPAM
}

enum ContactKind {
  GENERAL
  CATERING
  EVENTS
  GIFTING
  CRAVINGS
  PRESS
}

model ContactEnquiry {
  id     String        @id @default(uuid())
  kind   ContactKind   @default(GENERAL)
  status ContactStatus @default(NEW)

  name  String
  email String
  phone String?

  eventDate  DateTime?
  eventType  String?
  guestCount Int?
  budgetBand String?
  dietary    String?

  notes String

  source    String?
  ip        String?
  userAgent String?

  internalNotes String?
  handledBy     String?
  handledAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([kind, status])
  @@index([email])
}

// =============================================================
// Gifting commerce
// =============================================================

enum GiftCategory {
  CORPORATE
  WEDDINGS
  PRIVATE
}

model GiftCollection {
  id            String       @id @default(uuid())
  slug          String       @unique
  category      GiftCategory
  name          String
  description   String
  /// Items list as a JSON array of strings.
  items         Json
  /// Unit price in minor units (pence) — the unit price *per box*.
  unitPriceMinor Int
  /// Indicative max price for marketing copy (e.g. £10–£15). Null = exact price.
  priceMaxMinor Int?
  currency      String       @default("gbp")
  moq           Int          @default(1)
  leadTimeDays  Int          @default(56)
  imageUrl      String?
  published     Boolean      @default(false)
  position      Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems GiftOrderItem[]

  @@index([category, published, position])
  @@index([published, position])
}

enum GiftOrderStatus {
  /// Stripe Checkout Session created; payment not yet completed.
  PENDING_PAYMENT
  /// Payment succeeded; admin needs to send a design mock-up.
  AWAITING_DESIGN_APPROVAL
  /// Admin has uploaded a mock-up; customer needs to approve.
  DESIGN_SENT
  /// Customer approved; production starts.
  IN_PRODUCTION
  /// Order has shipped.
  SHIPPED
  /// Order delivered.
  DELIVERED
  /// Cancelled before/after payment.
  CANCELLED
  /// Refunded after payment.
  REFUNDED
}

model GiftOrder {
  id        String          @id @default(uuid())
  /// Human-readable reference, e.g. NIMI-2026-0001.
  reference String          @unique
  userId    String?
  email     String
  name      String
  status    GiftOrderStatus @default(PENDING_PAYMENT)

  totalMinor Int
  currency   String @default("gbp")

  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique

  shippingLine1    String?
  shippingLine2    String?
  shippingCity     String?
  shippingPostcode String?
  shippingCountry  String?

  notes         String?
  internalNotes String?

  /// The customer ticked the "I accept that final designs must be
  /// approved before production starts" checkbox at checkout. PRD-required
  /// for every paid gift order. Defaults to false for historical rows that
  /// pre-date the field; the API now refuses checkout without it.
  designApprovalAccepted Boolean @default(false)

  /// Optional carrier tracking number, populated by admin when the order
  /// transitions to SHIPPED.
  trackingNumber String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?
  approvedAt  DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?

  items GiftOrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([email])
}

model GiftOrderItem {
  id           String @id @default(uuid())
  orderId      String
  collectionId String

  /// Immutable snapshot of the collection at order time — name, description,
  /// items, price. Surviving collection deletion or price changes.
  collectionSnapshot Json

  quantity       Int
  unitPriceMinor Int
  totalMinor     Int

  /// Customisation payload: { names, dates, colourTheme, message, logoUrl } — all optional.
  customisation Json?

  createdAt DateTime @default(now())

  order      GiftOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  collection GiftCollection @relation(fields: [collectionId], references: [id])

  @@index([orderId])
}

/// Append-only Stripe event log for idempotency + reconciliation.
model StripeEvent {
  id          String    @id // Stripe event id (evt_…)
  type        String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  /// Full Stripe event payload — useful for replays and audits.
  payload     Json

  @@index([type, receivedAt])
}

/// Sequence used to allocate the human-readable reference for a GiftOrder.
/// Postgres SEQUENCE handles concurrency for us; this row exists only as a
/// versioning anchor for migrations.
model OrderSequenceMarker {
  id        String   @id @default(uuid())
  year      Int
  next      Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([year])
}

// =============================================================
// Pastry Cravings — subscriptions + rolling credit ledger
// =============================================================

model CravingsPlan {
  id                 String   @id @default(uuid())
  slug               String   @unique
  name               String
  /// Monthly subscription amount in minor units (pence).
  monthlyAmountMinor Int
  currency           String   @default("gbp")
  /// Stripe Price id for this plan (price_…). Allocated when the plan is published.
  stripePriceId      String?  @unique
  /// Stripe Product id for this plan (prod_…).
  stripeProductId    String?  @unique
  active             Boolean  @default(false)
  position           Int      @default(0)
  description        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@index([active, position])
}

enum SubscriptionStatus {
  /// Trial / pending — Stripe says `incomplete` etc. Treat as not yet earning credit.
  PENDING
  /// Active and earning credit on each invoice.paid.
  ACTIVE
  /// Paused via Stripe Customer Portal — no charges, no accrual.
  PAUSED
  /// Past-due / unpaid — Stripe will retry.
  PAST_DUE
  /// Cancelled but credit may still be redeemable until expiry.
  CANCELLED
  /// Cancelled and credit expired.
  ENDED
}

model Subscription {
  id                    String              @id @default(uuid())
  userId                String              @unique
  planId                String?
  stripeCustomerId      String              @unique
  stripeSubscriptionId  String?             @unique
  status                SubscriptionStatus  @default(PENDING)
  /// Snapshot of the monthly amount at last sync. Source of truth is Stripe;
  /// this is for fast read paths (e.g. account dashboard).
  monthlyAmountMinor    Int
  currency              String              @default("gbp")
  currentPeriodStart    DateTime?
  currentPeriodEnd      DateTime?
  pausedUntil           DateTime?
  cancelAt              DateTime?
  cancelledAt           DateTime?
  /// Date after which any remaining credit balance expires (12 months after cancel by default).
  creditExpiresAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan CravingsPlan? @relation(fields: [planId], references: [id])

  @@index([status])
  @@index([planId])
}

enum CreditTxType {
  /// Monthly accrual on invoice.paid.
  ACCRUAL
  /// Customer redeemed against a pastry order.
  REDEMPTION
  /// Manual adjustment by an admin (e.g. apology credit).
  ADJUSTMENT
  /// Credit cap reached — overflow forfeited.
  CAP_FORFEIT
  /// Credit expired N months after subscription cancellation.
  EXPIRY
  /// Refund (negative balance correction).
  REFUND
}

///
/// Append-only credit ledger.
///
/// The customer's available balance is `SUM(amountMinor) WHERE userId = ?`.
/// `balanceAfter` is denormalised for fast reads but must always equal the
/// running sum at write time. A nightly reconciliation job (Phase 7) verifies
/// `balanceAfter` against the recomputed sum and alerts on drift.
///
/// Idempotency is enforced via `(userId, sourceType, sourceId)` uniqueness for
/// sources that have a stable id (Stripe invoice id, refund id). For ADJUSTMENT
/// and REDEMPTION the source is the admin/order id and uniqueness is per-row.
///
model CreditTransaction {
  id           String       @id @default(uuid())
  userId       String
  type         CreditTxType
  /// Positive for accrual/adjustment, negative for redemption/expiry/forfeit.
  amountMinor  Int
  /// Running balance after this transaction is applied.
  balanceAfter Int
  /// E.g. "stripe.invoice", "stripe.refund", "order.refund", "admin", "system.expiry".
  sourceType   String
  /// E.g. invoice id, order id, audit log id.
  sourceId     String?
  reason       String?
  /// Who initiated the transaction (admin user id, or "system" for automated).
  createdBy    String

  createdAt DateTime @default(now())

  @@unique([userId, sourceType, sourceId])
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// =============================================================
// Testimonials — public-facing reviews with admin CRUD.
// =============================================================

///
/// A customer testimonial / review surfaced on the marketing site.
///
/// Status model:
///   - `isPublished = false` keeps a row in the admin list but hides it
///     from public endpoints. Admins control publish/unpublish without
///     deleting the row, so audit history is preserved.
///   - `displayOrder` lets the founder hand-curate which testimonial
///     leads the section (lower number = earlier in the list).
///
/// Consent + privacy:
///   - `authorName` should be the display name the customer agreed to.
///     We don't store full names by default; admin enters whatever was
///     consented to (e.g. "Ada O." or "Ada & Tobi").
///   - No PII beyond a display name is captured.
///
model Testimonial {
  id           String   @id @default(uuid())
  /// Display name as the customer consented to.
  authorName   String
  /// Free-text role/context — e.g. "Bride", "Head of Events", "Wedding · Sept 2025".
  role         String?
  /// The testimonial body. Plain text, max ~1KB enforced at API level.
  body         String
  /// 1–5 stars. Optional — many testimonials don't include a numeric rating.
  rating       Int?
  /// Free-text event type — wedding, corporate, birthday, etc.
  eventType    String?
  /// Visible on the public site only when true.
  isPublished  Boolean  @default(false)
  /// Lower numbers render first. Use 0 for "no preference".
  displayOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  @@index([isPublished, displayOrder])
  @@index([createdAt])
}

// =============================================================
// Pastries — the menu of items customers buy with cash + Indulgence Credits.
// =============================================================

///
/// A single pastry / drink item in the Indulgence Club menu.
///
/// Pricing is stored in minor units (pence) to avoid float drift. The
/// admin manages the catalog via /admin/menu; the public /cravings page
/// renders only `available = true` items sorted by `displayOrder` then
/// `createdAt`.
///
/// `tags` is a free-form JSON array of short labels (e.g. `["savoury",
/// "spicy"]`). Used for filtering and presentation hints — never for
/// pricing logic. Keep tags lowercase, dash-separated, < 24 chars each.
///
/// `batchLimit` is the max units the kitchen can produce in one fulfilment
/// window. NULL means unlimited. The cart enforces this by checking
/// existing order quantities for the same fulfilment day at checkout time.
///
/// Order items snapshot the entire item at order creation, so renaming
/// or deleting a `PastryItem` later doesn't corrupt historical orders.
///
model PastryItem {
  id           String  @id @default(uuid())
  /// URL-safe identifier — used in admin URLs and as a stable handle in
  /// audit logs. Lowercase letters, numbers, hyphens.
  slug         String  @unique
  name         String
  description  String?

  priceMinor   Int
  currency     String  @default("gbp")

  imageUrl     String?
  imageAlt     String?

  /// Free-form lowercase tags. Stored as JSON for flexibility.
  tags         Json    @default("[]")

  /// Daily/per-batch unit cap. NULL = no cap.
  batchLimit   Int?
  /// Days from order to ready (0 = same day, 1 = next day, etc).
  leadTimeDays Int     @default(0)

  /// Lower renders earlier. Hand-curated by admin.
  displayOrder Int     @default(0)
  /// Public surface shows only `available = true`.
  available    Boolean @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?

  @@index([available, displayOrder])
  @@index([createdAt])

  cartItems  PastryCartItem[]
  orderItems PastryOrderItem[]
}

// =============================================================
// Pastry cart + orders.
// =============================================================

///
/// Per-user cart. v1 supports authenticated users only — guest carts add
/// complexity we don't need for soft launch and the Indulgence Club value
/// proposition assumes an account anyway. The cart is always 1:1 with the
/// user (`@unique`), so adding the same item twice updates a single
/// PastryCartItem row instead of duplicating.
///
model PastryCart {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PastryCartItem[]
}

model PastryCartItem {
  id           String     @id @default(uuid())
  cartId       String
  cart         PastryCart @relation(fields: [cartId], references: [id], onDelete: Cascade)
  pastryItemId String
  pastryItem   PastryItem @relation(fields: [pastryItemId], references: [id], onDelete: Cascade)
  quantity     Int
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  /// One row per (cart, item). Adjusting quantity updates the existing row.
  @@unique([cartId, pastryItemId])
}

///
/// Pastry order status pipeline. Distinct from GiftOrderStatus because
/// pastries skip the design-approval step.
///
enum PastryOrderStatus {
  /// Stripe Checkout session created; payment not yet completed.
  PENDING_PAYMENT
  /// Payment succeeded. Kitchen hasn't started yet.
  PAID
  /// Kitchen has started production.
  PREPARING
  /// Ready for collection or pickup-by-courier.
  READY
  /// Out for delivery.
  SHIPPED
  /// Delivered to recipient.
  DELIVERED
  /// Cancelled before/after payment.
  CANCELLED
  /// Refunded after payment.
  REFUNDED
}

///
/// A pastry order. Created in PENDING_PAYMENT before Stripe Checkout
/// redirect; promoted to PAID by the webhook on `checkout.session.completed`.
///
/// Pricing breakdown:
///   - subtotalMinor       = sum of unitPrice × qty across items
///   - creditAppliedMinor  = Indulgence Credits auto-applied at checkout
///   - totalMinor          = subtotal − credit; this is what Stripe charges
///
/// Credits are deducted in the same DB transaction as the order PAID
/// transition, so a credit is never debited without a confirmed payment.
///
/// `creditTransactionId` cross-references the CreditTransaction row that
/// moved the balance, for audit traceability.
///
model PastryOrder {
  id        String            @id @default(uuid())
  /// Human-readable reference, e.g. NIMI-P-2026-0001.
  reference String            @unique
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  email     String
  name      String
  phone     String?
  status    PastryOrderStatus @default(PENDING_PAYMENT)

  subtotalMinor      Int
  creditAppliedMinor Int    @default(0)
  totalMinor         Int
  currency           String @default("gbp")

  stripeSessionId       String? @unique
  stripePaymentIntentId String? @unique

  /// Set when the credit deduction transaction was written.
  creditTransactionId String? @unique

  /// Delivery is the v1 default. Address is required at checkout.
  shippingLine1    String
  shippingLine2    String?
  shippingCity     String
  shippingPostcode String
  shippingCountry  String  @default("GB")

  /// Customer-facing notes (allergies, instructions, gate codes etc.).
  notes         String?
  /// Admin-only notes — never surfaced in customer email.
  internalNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paidAt      DateTime?
  preparingAt DateTime?
  readyAt     DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  items PastryOrderItem[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

///
/// Snapshot of a pastry at order time. We persist the original item id
/// for analytics, but render history from the snapshot fields so renaming
/// or deleting a PastryItem later doesn't corrupt past orders.
///
model PastryOrderItem {
  id             String       @id @default(uuid())
  orderId        String
  order          PastryOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  pastryItemId   String?
  pastryItem     PastryItem?  @relation(fields: [pastryItemId], references: [id], onDelete: SetNull)
  /// `{ slug, name, description, imageUrl, tags }` snapshot at order time.
  itemSnapshot   Json
  quantity       Int
  unitPriceMinor Int
  totalMinor     Int

  createdAt DateTime @default(now())
}

///
/// Sequence marker for human-readable order references (NIMI-P-YYYY-NNNN).
/// Mirrors the existing OrderSequenceMarker pattern used for gift orders.
///
model PastryOrderSequenceMarker {
  /// Year, e.g. 2026. Each year resets the counter.
  year       Int @id
  nextNumber Int @default(1)
}

// =============================================================
// In-app notifications
// =============================================================
//
// One row per recipient. Staff-audience events (a new paid order, a new
// contact enquiry) fan out at creation time — we insert one notification
// row per OWNER/EDITOR/SUPPORT user. This keeps the read-state model
// trivial (per-row `readAt`) and the query for unread counts cheap
// (`WHERE userId = $1 AND readAt IS NULL`). The trade-off is some write
// amplification when a paid order lands — n inserts for n staff members.
// For Nimi's team size that's negligible, and the simplicity is worth it.
//
// `href` is the in-app deep-link to follow when the user clicks the
// notification (e.g. `/admin/pastry-orders/NIMI-P-2026-0010`). It's
// always relative to the web origin; the bell UI uses it verbatim.
//
// `kind` is a stable identifier — frontend may use it to choose an
// icon or grouping, and analytics may bucket by it.
//
// We deliberately don't store an email-sent flag here — email and in-app
// are independent channels owned by separate code paths.
model Notification {
  id     String @id @default(uuid())
  userId String

  /// Stable identifier for grouping/analytics — e.g.
  ///   pastry.order.paid           — fired on payment success
  ///   pastry.order.preparing      — admin moved order to PREPARING
  ///   pastry.order.ready          — admin moved order to READY
  ///   pastry.order.shipped        — admin moved order to SHIPPED
  ///   pastry.order.delivered      — admin moved order to DELIVERED
  ///   pastry.order.cancelled      — admin cancelled
  ///   contact.enquiry.new         — new enquiry submitted (admin-only)
  ///   cravings.subscription.new   — new Indulgence Club subscriber (admin-only)
  kind String

  title String
  body  String?
  /// In-app deep-link to follow when the user clicks the row.
  href String?

  /// Null while unread; stamped when the user clicks or marks-all-read.
  readAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hot read paths: list newest-first, unread count.
  @@index([userId, createdAt])
  @@index([userId, readAt])
}
